{
  "name": "@devxcrew/ui",
  "version": "1.0.80",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./styles.css": "./dist/src/styles.css",
    "./design-system": {
      "types": "./dist/src/design-system/index.d.ts",
      "import": "./dist/src/design-system/index.js"
    },
    "./workspace": {
      "types": "./dist/src/workspace/index.d.ts",
      "import": "./dist/src/workspace/index.js"
    },
    "./components/*": {
      "types": "./dist/src/components/*.d.ts",
      "import": "./dist/src/components/*.js"
    },
    "./layouts/*": {
      "types": "./dist/src/layouts/*.d.ts",
      "import": "./dist/src/layouts/*.js"
    },
    "./blocks/*": {
      "types": "./dist/src/blocks/*.d.ts",
      "import": "./dist/src/blocks/*.js"
    },
    "./lib/*": {
      "types": "./dist/src/lib/*.d.ts",
      "import": "./dist/src/lib/*.js"
    },
    "./workspace/*": {
      "types": "./dist/src/workspace/*.d.ts",
      "import": "./dist/src/workspace/*.js"
    },
    "./presets/*": {
      "types": "./dist/src/workspace/presets/*.d.ts",
      "import": "./dist/src/workspace/presets/*.js"
    }
  },
  "scripts": {
    "build": "codexsun-cli build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "dependencies:check": "codexsun-cli dependencies:check",
    "check": "npm run dependencies:check && npm run check:versions && npm run lines:check && npm run typecheck && npm run lint && npm test",
    "test": "node --test",
    "prepack": "npm run build",
    "pack": "codexsun-cli pack",
    "release:check": "npm run check && npm run format:check && npm pack --dry-run",
    "release": "npm run release:check && npm publish --access public",
    "package:check": "codexsun-cli package:check",
    "version:show": "codexsun-cli version:show",
    "version:bump": "codexsun-cli version:bump",
    "check:versions": "codexsun-cli check:versions",
    "changelog:append": "codexsun-cli changelog:append",
    "github:now": "codexsun-cli github:now",
    "lines:check": "codexsun-cli lines:check",
    "lines:fix": "codexsun-cli lines:fix"
  },
